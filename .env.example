# Runtime
CIPHER_ENV=production
CIPHER_LOG_LEVEL=INFO
CIPHER_VERBOSE_REQUEST_LOGGING=false
CIPHER_CONFIG_DIR=./config
CIPHER_STATE_DIR=./state

# OpenClaw: keep the Gateway bound to loopback.
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=cipher
CIPHER_PRIMARY_RUNTIME=codex
# Empty means use the current model selected/discovered by OpenClaw/Codex.
CIPHER_PRIMARY_MODEL=

# Home Assistant
HOME_ASSISTANT_URL=http://127.0.0.1:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT_SECONDS=5
# Proactive spoken announcements when a background Alexa task finishes after the sync budget.
# Requires an existing Home Assistant notify service (e.g. from the Alexa Media Player custom
# integration) and a do-not-disturb entity to check before speaking. Leave either empty to
# silently disable this feature -- the "ask me for the result" fallback always still works.
ALEXA_PROACTIVE_ANNOUNCE_ENABLED=true
HOME_ASSISTANT_ALEXA_NOTIFY_SERVICE=
HOME_ASSISTANT_ALEXA_DND_ENTITY=

# Alexa bridge. Generate with: openssl rand -hex 32
ALEXA_ID_HMAC_SECRET=
# From the Alexa Developer Console: Custom Skill -> Endpoint -> Skill ID.
ALEXA_SKILL_ID=
ALEXA_BRIDGE_HOST=127.0.0.1
ALEXA_BRIDGE_PORT=8787
ALEXA_SYNC_BUDGET_SECONDS=6
ALEXA_OPENCLAW_TIMEOUT_SECONDS=120
ALEXA_REQUEST_MAX_BYTES=16384
ALEXA_SIGNATURE_MAX_AGE_SECONDS=150
ALEXA_RATE_LIMIT_PER_MINUTE=20

# Optional web-search provider consumed by OpenClaw, not Cipher services.
BRAVE_API_KEY=
